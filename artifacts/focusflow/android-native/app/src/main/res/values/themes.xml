<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FocusFlow Launcher Theme - Material 3 (Material You) -->
    <style name="Theme.FocusFlow.Launcher" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (Focus Indigo) -->
        <item name="colorPrimary">@color/focus_indigo</item>
        <item name="colorPrimaryVariant">@color/focus_indigo_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/focus_indigo_light</item>
        <item name="colorSecondaryVariant">@color/focus_indigo</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>

        <!-- Error colors for blocked apps -->
        <item name="colorError">@color/error_red</item>
        <item name="colorErrorContainer">@color/error_container_light</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOnErrorContainer">@color/on_error_container_light</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/on_background_light</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>

        <!-- Typography - Material 3 Type Scale -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.FocusFlow.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.FocusFlow.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.FocusFlow.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.FocusFlow.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.FocusFlow.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.FocusFlow.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.FocusFlow.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.FocusFlow.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.FocusFlow.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.FocusFlow.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.FocusFlow.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.FocusFlow.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.FocusFlow.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.FocusFlow.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.FocusFlow.LabelSmall</item>

        <!-- Shapes - Material 3 Shape Scale -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.FocusFlow.CornerExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.FocusFlow.CornerSmall</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.FocusFlow.CornerMedium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.FocusFlow.CornerLarge</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.FocusFlow.CornerExtraLarge</item>

        <!-- Elevation overlays (for dark mode) -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/elevation_overlay_light</item>

        <!-- Ripple -->
        <item name="android:selectableItemBackground">@drawable/ripple_focus</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/ripple_focus_borderless</item>
    </style>

    <!-- Dark variant -->
    <style name="Theme.FocusFlow.Launcher.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/focus_indigo_light</item>
        <item name="colorPrimaryVariant">@color/focus_indigo</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/focus_indigo</item>
        <item name="colorSecondaryVariant">@color/focus_indigo_light</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>

        <item name="colorError">@color/error_red_light</item>
        <item name="colorErrorContainer">@color/error_container_dark</item>
        <item name="colorOnError">@color/black</item>
        <item name="colorOnErrorContainer">@color/on_error_container_dark</item>

        <item name="colorOutline">@color/outline_dark</item>
        <item name="colorOutlineVariant">@color/outline_variant_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/on_background_dark</item>

        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.FocusFlow.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.FocusFlow.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.FocusFlow.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.FocusFlow.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.FocusFlow.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.FocusFlow.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.FocusFlow.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.FocusFlow.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.FocusFlow.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.FocusFlow.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.FocusFlow.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.FocusFlow.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.FocusFlow.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.FocusFlow.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.FocusFlow.LabelSmall</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.FocusFlow.CornerExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.FocusFlow.CornerSmall</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.FocusFlow.CornerMedium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.FocusFlow.CornerLarge</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.FocusFlow.CornerExtraLarge</item>

        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/elevation_overlay_dark</item>

        <item name="android:selectableItemBackground">@drawable/ripple_focus</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/ripple_focus_borderless</item>
    </style>

    <!-- Typography - FocusFlow Material 3 Type Scale -->
    <style name="TextAppearance.FocusFlow.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.016</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.FocusFlow.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">45sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.008</item>
