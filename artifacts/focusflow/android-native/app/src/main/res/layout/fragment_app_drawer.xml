<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Overlay background (semi-transparent) -->
    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Drawer Sheet (Bottom Sheet) -->
    <LinearLayout
        android:id="@+id/drawer_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/drawer_background"
        android:translationY="100%">

        <!-- Drag Handle -->
        <View
            android:id="@+id/drawer_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/drawer_handle_bg" />

        <!-- Drawer Title -->
        <TextView
            android:id="@+id/drawer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="All Apps"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/drawer_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search apps…"
            android:hintTextColor="#556688AA"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:background="@drawable/drawer_search_bg"
            android:padding="12dp"
            android:layout_margin="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Scrollable Grid Container -->
        <ScrollView
            android:id="@+id/drawer_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:isVerticalScrollBarEnabled="false">

            <LinearLayout
                android:id="@+id/drawer_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>