<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Focus Shield Icon -->
    <ImageView
        android:id="@+id/shield_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_focus_shield_large" />

    <!-- Title -->
    <TextView
        android:id="@+id/shield_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="App Blocked"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- Message -->
    <TextView
        android:id="@+id/shield_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="This app is blocked by your focus rules."
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Request Allowance Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_request_allowance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Request 5 min Access"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_timer"
        app:iconGravity="start"
        app:iconPadding="8dp" />

    <!-- Add to Allowlist Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_allowlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Add to Focus Allowlist"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_add_circle"
        app:iconGravity="start"
        app:iconPadding="8dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>