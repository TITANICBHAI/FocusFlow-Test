<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal">

    <!-- Date View -->
    <TextView
        android:id="@+id/focus_date_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:textColor="#EEF0FF"
        android:textSize="13sp" />

    <!-- Progress Ring + Clock (centered) -->
    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="4dp">

        <!-- Material 3 CircularProgressIndicator (Focus Ring) -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/focus_progress_indicator"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="200dp"
            app:trackColor="?attr/colorSurfaceContainerHighest"
            app:trackThickness="8dp" />

        <!-- Digital Clock (shown when no focus) -->
        <TextClock
            android:id="@+id/focus_time_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="72sp"
            android:format12Hour="hh:mm" />

        <!-- Time Remaining (shown during focus) -->
        <TextView
            android:id="@+id/focus_time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:visibility="gone" />

        <!-- AM/PM View -->
        <TextView
            android:id="@+id/focus_ampm_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="14dp"
            android:gravity="bottom"
            android:textColor="#EEF0FF"
            android:textSize="20sp" />

    </FrameLayout>

    <!-- Date View (shown below clock) -->
    <TextView
        android:id="@+id/focus_date_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:textColor="#EEF0FF"
        android:textSize="13sp" />

    <!-- AM/PM View -->
    <TextView
        android:id="@+id/focus_ampm_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="56dp"
        android:gravity="bottom"
        android:textColor="#EEF0FF"
        android:textSize="20sp" />

    <!-- Time Remaining (shown during focus, below progress ring) -->
    <TextView
        android:id="@+id/focus_time_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="220dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:visibility="gone" />

</FrameLayout>